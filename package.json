{
  "name": "novus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run events && next build && node scripts/bundle-report.mjs --check",
    "bundle": "node scripts/bundle-report.mjs",
    "start": "next start",
    "lint": "next lint",
    "events": "node scripts/parse-events.mjs && node scripts/validate-events.mjs && node scripts/validate-activities.mjs && node scripts/validate-tokens.mjs && node scripts/validate-motion.mjs",
    "sim": "node scripts/simulate.mjs",
    "test:db": "node scripts/db-test.mjs",
    "test:ai": "node scripts/ai-test.mjs",
    "check": "npm run events && tsc --noEmit && npm run sim 30 8 && npm run test:ai && npm run test:board && npm run test:islands && npm run test:rules",
    "capture": "node scripts/capture.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:native:only": "node scripts/build-native.mjs --no-sync",
    "ios": "npm run build:native && npx cap open ios",
    "android": "npm run build:native && npx cap open android",
    "sync": "npx cap sync",
    "audit:phone": "node scripts/audit-phone.mjs",
    "icons": "node scripts/make-icons.mjs && node scripts/make-app-icons.mjs",
    "market:fixture": "node scripts/market-fixture.mjs",
    "test:outside": "node scripts/market-fixture.mjs --check && node scripts/verify-pbxproj.mjs",
    "test:board": "node scripts/leaderboard-test.mjs",
    "test:islands": "node scripts/islands-test.mjs",
    "test:rules": "node scripts/rules-test.mjs",
    "test:exits": "node scripts/exit-audit.mjs",
    "test:notes": "node scripts/notes-clip-probe.mjs",
    "test:islands:layout": "node scripts/islands-layout-probe.mjs",
    "test:home:fold": "node scripts/home-fold-probe.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.3.40",
    "@mediapipe/tasks-vision": "^0.10.17",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "^12.0.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.177.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
