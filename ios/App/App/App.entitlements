<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's half of the shared container. See
	     NovusWidgets/NovusWidgets.entitlements for the other half and for why
	     the two strings have to be identical. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.novuspitch.app</string>
	</array>

	<!-- Sign in with Apple.
	     Xcode writes this key when you add the capability by hand; it is here
	     so nobody has to, and so a fresh clone builds with the same
	     entitlements as the machine that shipped the last build. Without it
	     the system sheet does not appear at all and the plugin call fails
	     with an error no player can act on.

	     This is only half of it. The App ID (com.novuspitch.app) has to carry
	     the capability in the developer portal as well, or the provisioning
	     profile will not include this entitlement and the signature is
	     rejected at install. docs/OAUTH-SETUP.md §4.1 is that half. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
