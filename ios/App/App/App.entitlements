<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's half of the shared container. See
	     NovusWidgets/NovusWidgets.entitlements for the other half and for why
	     the two strings have to be identical. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.novuspitch.app</string>
	</array>
</dict>
</plist>
