<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Novus</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The camera and the microphone are the one part of this game that is
	     not simulated: a fiscal year does not close until you have pitched out
	     loud, on camera. Both strings are shown verbatim in the system prompt,
	     so they say what the recording is for and what happens to it. -->
	<key>NSCameraUsageDescription</key>
	<string>Novus records your year-end pitch so the investor panel can watch you deliver it. The recording stays on your device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Novus listens while you pitch so it can score your delivery and coach it. Audio stays on your device.</string>

	<!-- Live transcription. lib/ai/transcribe.ts reaches for the Web Speech API
	     while the player is still talking, and inside a WKWebView that API is
	     SFSpeechRecognizer wearing a browser's name — a TCC-protected resource.
	     Without this string the request is refused before a prompt is ever
	     shown, and the live path silently degrades to the server endpoint or to
	     typing.

	     Deliberately NOT "stays on your device", unlike the two above. The
	     recogniser on this path is Apple's rather than ours and may send audio
	     to Apple to do the work; transcribe.ts says so in its own privacy note.
	     Video never leaves the device — speech is the one thing that might, and
	     a usage string a reviewer reads must not claim otherwise. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Novus turns your pitch into text while you speak, so the investor panel can judge what you said.</string>

	<!-- Nothing in this app implements or links non-standard cryptography, so
	     declaring it here answers the export-compliance question once instead
	     of on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The category the binary declares, matching the one chosen in App Store
	     Connect. Set in both places or the listing and the build disagree, and
	     the disagreement is a question in review rather than an error. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.simulation-games</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<!-- No UISceneStoryboardFile on purpose. With one set, UIKit
					     builds a window and a CAPBridgeViewController — and so a
					     whole second WKWebView — before the scene delegate runs
					     and replaces both. SceneDelegate constructs the root
					     controller itself, so the storyboard would only ever be
					     a discarded webview's worth of launch time. -->
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Portrait, and only portrait. The whole layout is a phone held upright:
	     a masthead, a ledger, a log and one button at the bottom. There is no
	     landscape composition of that, and shipping an orientation nobody
	     designed is how a tab bar ends up over a button. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
