<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Novus</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The camera and the microphone are the one part of this game that is
	     not simulated: a fiscal year does not close until you have pitched out
	     loud, on camera. Both strings are shown verbatim in the system prompt,
	     so they say what the recording is for and what happens to it. -->
	<key>NSCameraUsageDescription</key>
	<string>Novus records your year-end pitch so the investor panel can watch you deliver it. The recording stays on your device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Novus listens while you pitch so it can score your delivery and coach it. Audio stays on your device.</string>

	<!-- Nothing in this app implements or links non-standard cryptography, so
	     declaring it here answers the export-compliance question once instead
	     of on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<!-- No UISceneStoryboardFile on purpose. With one set, UIKit
					     builds a window and a CAPBridgeViewController — and so a
					     whole second WKWebView — before the scene delegate runs
					     and replaces both. SceneDelegate constructs the root
					     controller itself, so the storyboard would only ever be
					     a discarded webview's worth of launch time. -->
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Portrait, and only portrait. The whole layout is a phone held upright:
	     a masthead, a ledger, a log and one button at the bottom. There is no
	     landscape composition of that, and shipping an orientation nobody
	     designed is how a tab bar ends up over a button. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
