# Copy to .env.local and fill in. .env.local is already gitignored.
# Values come from your Supabase project: Settings → API.

# ── Supabase ────────────────────────────────────────────────────────────────
# These two are all the app needs today. Both come from the Supabase dashboard:
#   Project Settings → API → "Project URL" and "Project API keys → anon public"
#   (newer projects call the second one a "publishable" key, sb_publishable_…).
#
# The URL and anon key are public by design — RLS is what protects the data,
# not the key. Leaving them unset is supported: the game runs on localStorage
# alone and simply does not sync.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY, and it bypasses RLS entirely. Never prefix it with
# NEXT_PUBLIC_, and never import it into a file a Client Component can reach —
# one "use client" at the top of the wrong file publishes it to every browser.
# Dashboard: Project Settings → API → service_role.
#
# Required for billing: the Stripe webhook writes public.entitlements, and that
# table has a SELECT policy and nothing else precisely so the browser cannot.
# Leave unset and billing stays off; everything else still works.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Full walkthrough, including which products to create: docs/STRIPE-SETUP.md
#
# Billing is ALL-OR-NOTHING. Unless every one of STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY and NEXT_PUBLIC_SITE_URL is
# set, billingConfigured() is false and the Pro button keeps its pre-billing
# behaviour (grants on this device, takes no card). Half-configured billing
# would take money and grant nothing, so it is not a supported state.

# The SECRET key — sk_test_… while testing, sk_live_… in production. There is
# deliberately NO publishable key here: the browser never loads stripe.js. The
# player is redirected to Stripe's own hosted checkout page, so no third-party
# script and no third-party identifier runs on a page shown to a minor.
# Dashboard: Developers → API keys → Secret key.
STRIPE_SECRET_KEY=

# Verifies that a webhook really came from Stripe. Without it, the endpoint
# that grants Pro would accept a POST from anyone. This is NOT an API key — it
# is shown once when you create the webhook endpoint (whsec_…), and the Stripe
# CLI prints its own separate one for local testing.
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends the player back after paying. Absolute, no trailing slash.
# It is configuration rather than something inferred from the request, because
# the Host header is attacker-controlled and would let someone point a
# successful purchase at their own domain. e.g. https://novus.example.com
# For local testing: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# EITHER a price id (price_…) OR a product id (prod_…) — both work.
#
# A product is the thing; a price is what it costs, and one product can carry
# several. Checkout needs the price, so a product id is resolved to its price
# (default_price, or its single active price). If a product has two or more
# active prices, that is ambiguous and the app refuses rather than guessing at
# a cadence — name the price id in that case.
#
# Whichever form you use, the app REFUSES to open checkout unless the amount,
# currency and billing interval match lib/monetization.ts. That is what makes
# accepting product ids safe: a wrong id fails loudly before anyone is charged,
# rather than selling at a price no screen ever displayed.
STRIPE_PRICE_PRO_MONTHLY=      # recurring, $6.99 / month
STRIPE_PRICE_PRO_YEARLY=       # recurring, $39.99 / year
STRIPE_PRICE_INDUSTRY_PACK=    # one-time,  $2.99
STRIPE_PRICE_EXTRA_RUN_SLOT=   # one-time,  $1.99

# Chapter licences — 35 or 100 seats, yearly. These two are the ONLY SKUs with
# a default baked into the code (lib/stripe/catalogue.ts): leave them unset and
# the app sells the live products below; set them to override (e.g. test-mode
# copies). Safe either way — every checkout still verifies amount, currency and
# cadence against lib/monetization.ts before charging. Seats are handed out at
# /chapter; see docs/CHAPTERS.md.
# STRIPE_PRICE_CHAPTER_35=prod_V0RQl8TDKC3JKu     # recurring, $299 / year
# STRIPE_PRICE_CHAPTER_100=prod_V0RRsSw8Z2z0hD    # recurring, $599 / year
#
# Not sold, and no price id to set: cosmetic bundles are priced as a
# $1.99–$4.99 shelf with no per-bundle SKUs defined. See docs/STRIPE-SETUP.md.

# ── Chapter invite email (Resend) ───────────────────────────────────────────
# Invites are the app's own mail — our subject line, classroom volume — so
# they go through Resend (resend.com) rather than Supabase's auth mailer,
# which throttles at a handful per hour. Set BOTH or neither: with them unset,
# invites fall back to Supabase's own invite email (fine for a few seats,
# wrong for a whole class). docs/CHAPTERS.md §2 has the walkthrough.
#
# resend.com → API Keys. SERVER ONLY — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# The From header. Its domain must be verified in Resend (Domains → Add), or
# every send is refused — visibly, per row, in the /chapter console.
# e.g.  Novus <chapters@novuspitch.com>
RESEND_FROM=

# ── Leaderboard ─────────────────────────────────────────────────────────────
# Full walkthrough: docs/LEADERBOARD.md. All four have working defaults, so a
# deploy that sets none of them still runs the board correctly — just with the
# season below and with every entry waiting on a human.

# Pins replay compatibility. Bump BOTH when the engine or the event library
# changes: old tapes stop replaying to the same numbers when content moves, so
# a season is how a board resets instead of quietly re-scoring itself (§7.6).
# NOVUS_ENGINE_VERSION=1
# NOVUS_LEADERBOARD_SEASON=2026-Q3

# How a clean company name reaches the public board.
#
#   unset / anything else — every entry lands unlisted and waits for a human.
#                           This is what §9.3 asks for and it is the default.
#   clean                 — an entry whose name passes every check in
#                           lib/leaderboard/moderation.ts lists immediately.
#
# `clean` is faster and strictly worse: a blocklist catches what it knows about.
# Turn it on per deployment, and only with somebody reading the report queue.
# NOVUS_BOARD_AUTOLIST=clean

# Gates /api/leaderboard/moderate — the queue, and the only route that can make
# an entry public. UNSET MEANS THE ROUTE RETURNS 404, not that it is open. Use a
# long random string; it is checked in constant time.
# NOVUS_MODERATOR_TOKEN=

# ── AI ──────────────────────────────────────────────────────────────────────
# Full walkthrough: docs/AI-SETUP.md
#
# Each of the three is INDEPENDENT — set one, get one. There is no all-or-
# nothing rule here as there is for billing, because every AI feature already
# has a complete local fallback: the browser's own voice, the browser's own
# speech recognition, and an offline resolver that reads the same transcript.
# An unset key therefore degrades quality and never function.
#
# All three are SERVER ONLY. They are read by app/api/{tts,stt,pitch}/route.ts
# and nowhere else. Never prefix them with NEXT_PUBLIC_ — that would compile the
# key into the JavaScript every player downloads.

# Shark and narrator voices. elevenlabs.io → Profile → API key.
# Without it the panel speaks in the browser's built-in voice.
ELEVENLABS_API_KEY=

# Transcribes a recorded pitch. console.deepgram.com → API keys.
# Without it the pitch is transcribed by the browser (Chrome/Safari) or typed.
# NOTE: this is the only key that sends a child's voice to a third party. Turn
# OFF data retention in the Deepgram project settings before using it in
# production — docs/AI-SETUP.md §3.
DEEPGRAM_API_KEY=

# The person on the other end of a cold call. openrouter.ai → Keys.
# Without it the offline resolver judges the pitch on the same transcript.
OPENROUTER_API_KEY=

# Model ids. Defaults are the cheap tiers and are fine; override when a
# provider retires one. Defaults: eleven_turbo_v2_5 · nova-3 ·
# anthropic/claude-haiku-4.5
# ELEVENLABS_MODEL=
# DEEPGRAM_MODEL=
# OPENROUTER_MODEL=

# Casting. Optional: with none of these set, /api/tts asks the account which
# voices it has and gives each character a different one, deterministically. Set
# them to cast deliberately — lib/ai/voices.ts has the direction for each part.
# ELEVENLABS_VOICE_MARCUS=
# ELEVENLABS_VOICE_SERENA=
# ELEVENLABS_VOICE_DEV=
# ELEVENLABS_VOICE_LILY=
# ELEVENLABS_VOICE_VIKTOR=
# ELEVENLABS_VOICE_CHAIR=
# ELEVENLABS_VOICE_NARRATOR=

# Spend caps. Per address per 15 minutes, and a hard ceiling across everyone per
# 24h. Defaults below. These need SUPABASE_SERVICE_ROLE_KEY to be enforced at
# all — without it there is no shared counter and no cap (docs/AI-SETUP.md §5).
# NOVUS_AI_TTS_PER_IP=300
# NOVUS_AI_STT_PER_IP=60
# NOVUS_AI_PITCH_PER_IP=60
# One request per spoken shark turn; a full Tank session is roughly a dozen.
# NOVUS_AI_PANEL_PER_IP=240
# One longer request per session, written after the room.
# NOVUS_AI_DEBRIEF_PER_IP=40
# One tiny request per company founded.
# NOVUS_AI_BRIEF_PER_IP=30
# NOVUS_AI_TTS_PER_DAY=20000
# NOVUS_AI_STT_PER_DAY=4000
# NOVUS_AI_PITCH_PER_DAY=4000
# NOVUS_AI_PANEL_PER_DAY=20000
# NOVUS_AI_DEBRIEF_PER_DAY=3000
# NOVUS_AI_BRIEF_PER_DAY=2000

# ── Seeing it fail ──────────────────────────────────────────────────────────
# Every AI feature here degrades to a COMPLETE local one, which means "no key",
# "rejected key", "route unreachable" and "working" are four states with one
# appearance. Two surfaces exist to tell them apart:
#
#   GET /api/ai   — the server side. Which keys are set, which the providers
#                   accepted, and the provider's own reason when they did not.
#                   Public, cached a minute, exposes no key material.
#   The banner    — the client side, on screen, when a feature has actually
#                   fallen back. This is the only thing that can show the app
#                   failing to REACH the server, which is the failure a browser
#                   tab never reproduces and the phone has no console to report.
#
# The banner is on in `npm run dev` and OFF in production builds, so a player
# or a demo audience never sees an amber warning about someone else's API key
# unless you ask for it. Set 1 to force it on (a staging deploy), 0 to silence
# it even in dev. GET /api/ai answers the same questions on any deploy.
# NEXT_PUBLIC_AI_DEBUG=1

# Only to point a feature at something OTHER than this app's own route. Unset,
# each client calls /api/tts, /api/stt and /api/pitch respectively, which is
# what makes setting a key above sufficient on its own.
# NEXT_PUBLIC_TTS_ENDPOINT=
# NEXT_PUBLIC_STT_ENDPOINT=
# NEXT_PUBLIC_PITCH_ENDPOINT=

# -- Human check on sign-up (Cloudflare Turnstile) ---------------------------
# Optional. Unset = no check, and the widget does not render, which is how
# local development works. Set BOTH or neither.
#
# Free and unlimited. dash.cloudflare.com -> Turnstile -> Add site: add your
# domain (plus `localhost` for local work) and Cloudflare gives you a site key
# and a secret key.
#
# This is the ONE third-party script in the app. It loads only when the sign-up
# form is opened, so a player who never makes an account never contacts
# Cloudflare - see components/landing/Turnstile.tsx. Turnstile sets no cookies
# and builds no cross-site profile, which is why it is the only widget of this
# kind defensible in front of children.
#
# Public: it is meant to be in the page, and is useless without the secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER ONLY. Never prefix this one with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

