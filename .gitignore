# dependencies
node_modules/
# the local cache the README tells you to install with when ~/.npm is
# root-owned. Following that advice should not leave 5,000 untracked files.
.npm-cache/

# next.js build output
.next/
out/
next-env.d.ts

# typescript incremental cache
*.tsbuildinfo

# generated content — rebuilt by `npm run events` from data/sections/*.json
# (data/events.json IS committed: the sim harness and the app read it directly,
#  and committing it keeps a clone runnable without a build step)

# env
.env
.env.local
.env*.local

# os
.DS_Store

# editor
.idea/
*.swp

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# agent skills — vendored third-party, restored from skills-lock.json.
# skills-lock.json IS committed (it pins all 7 by content hash); the 5.8 MB of
# skill bodies are not, same reasoning as package-lock.json vs node_modules.
# Restore with:  npx skills experimental_install
.claude/skills/

# Tier unlock clips — ~38 MB of source video, kept out of git history.
# Regenerate/reinstall from the raw renders; see scripts/make-characters.mjs.
public/founder/*.mp4
.assets-staging/
dist/
build/
*.log

# Screenshots from `npm run audit:phone`. Regenerated on demand.
.audit-shots/

# Where scripts/build-native.mjs parks app/api for the duration of a static
# export. Never committed, and restored in a finally — see that script for why
# the directory has to move at all.
.native-build/

# Capacitor's copy of the export, and the native build outputs. The iOS and
# Android projects ARE committed; what `cap sync` and Gradle generate inside
# them is not (ios/.gitignore and android/.gitignore carry the details).
android/app/release/
*.jks
*.keystore
!android/app/debug.keystore
.vercel
panel.tmp.mjs
