[
  {
    "id": "E-RIV-001",
    "title": "Marco Launches First",
    "category": "RIV",
    "text": "Marco ships the exact thing on your roadmap, two months early.",
    "stages": [1, 2, 3],
    "industries": "all",
    "weight": 7,
    "choices": [
      {
        "label": "Ship yours anyway, better",
        "known": "Qual −2",
        "outcome": {
          "effects": [{ "stat": "qual", "amount": -2 }],
          "special": ["or_wait"],
          "narration": "delay pressure"
        }
      },
      {
        "label": "Reposition against his flaws",
        "perform": {
          "type": "pitch",
          "pass": { "effects": [{ "stat": "share_pt", "amount": 2 }] },
          "fail": {
            "effects": [{ "stat": "brand", "amount": -2 }],
            "narration": "\"salty\" headlines"
          }
        }
      },
      {
        "label": "Do nothing loudly, keep building",
        "known": "Resp +1",
        "outcome": { "effects": [{ "stat": "respect", "amount": 1 }] }
      }
    ]
  },
