[
  {
    "id": "E-LIF-001",
    "title": "The 3AM Idea",
    "category": "LIF",
    "text": "You wake up with a \"brilliant\" idea and the urge to rebuild everything.",
    "stages": [1, 2, 3],
    "industries": "all",
    "weight": 7,
    "choices": [
      {
        "label": "Sleep on it 48h",
        "branches": [
          {
            "weight": 70,
            "outcome": {
              "effects": [{ "stat": "energy", "amount": 2 }],
              "narration": "it evaporates"
            }
          },
          {
            "weight": 30,
            "outcome": {
              "special": ["unlock:pivot_lite"],
              "narration": "it's real"
            }
          }
        ]
      },
      {
        "label": "Act tonight",
        "known": "En −8",
        "branches": [
          {
            "weight": 25,
            "outcome": {
              "effects": [
                { "stat": "energy", "amount": -8 },
                { "stat": "qual", "amount": 4 }
              ],
              "narration": "genius"
            }
          },
          {
            "weight": 75,
            "outcome": {
              "effects": [
                { "stat": "energy", "amount": -8 },
                { "stat": "tdebt", "amount": 1 }
              ],
              "narration": "mess"
            }
          }
        ]
      },
      {
        "label": "Write it down, park it",
        "outcome": {
          "special": ["idea_bank:qual"]
        }
      }
    ]
  },
