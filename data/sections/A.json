[
  {
    "id": "E-OPS-001",
    "title": "Supplier Price Hike",
    "category": "OPS",
    "text": "Your main supplier raises prices 18%, effective now.",
    "stages": [1, 2, 3, 4],
    "industries": "all",
    "weight": 8,
    "choices": [
      {
        "label": "Absorb it",
        "known": "GM −3",
        "outcome": {
          "effects": [
            { "stat": "gm_pt", "amount": -3 },
            { "stat": "suploy", "amount": 1 }
          ],
          "setFlags": ["supplier_loyal"]
        }
      },
      {
        "label": "Renegotiate",
        "perform": {
          "type": "nego",
          "pass": {
            "effects": [
              { "stat": "gm_pt", "amount": -1 },
              { "stat": "brand", "amount": 2 }
            ]
          },
          "fail": {
            "effects": [{ "stat": "rev_pct", "amount": -10, "durationQ": 2 }],
            "narration": "They drop you mid-call."
          }
        }
      },
      {
        "label": "Switch suppliers",
        "known": "Cash −1S · Qual −5 (2Q)",
        "outcome": {
          "effects": [
            { "stat": "cash_S", "amount": -1 },
            { "stat": "qual", "amount": -5, "durationQ": 2 },
            { "stat": "gm_pt", "amount": 2, "afterQ": 2 }
          ]
        }
      },
      {
        "label": "Raise your prices",
        "branches": [
          {
            "cond": { "stat": { "key": "brand", "gte": 60 } },
            "outcome": { "effects": [{ "stat": "rev_pct", "amount": -2, "durationQ": 2 }] }
          },
          {
            "fallback": true,
            "outcome": { "effects": [{ "stat": "rev_pct", "amount": -9, "durationQ": 2 }] }
          }
        ]
      }
    ],
    "rookieTerms": ["gross margin"]
  },
