[
  {
    "id": "E-RIV-101",
    "title": "The Empty Lane",
    "category": "RIV",
    "text": "You never picked a side. {rival} noticed the gap between \"proven\" and \"different\" was still open — and moved into it.",
    "stages": [2, 3, 4, 5],
    "industries": ["FOOD", "ECOM", "TECH", "CONTENT", "FASHION", "GAMING", "FITNESS", "BEAUTY", "EDTECH", "SUSTAIN", "TOYS", "PET"],
    "weight": 6,
    "once": true,
    "requiresFlags": ["stance_balance"],
    "choices": [
      {
        "label": "Commit to catching up on execution",
        "known": "Brand −3 · Share +1",
        "outcome": {
          "effects": [
            { "stat": "brand", "amount": -3 },
            { "stat": "share_pt", "amount": 1 }
          ],
          "setFlags": ["stance_imitate"],
          "narration": "Late to the lane, but in it. Nobody remembers who arrived first, only who's still there."
        }
      },
      {
        "label": "Commit to the different angle, late",
        "known": "Cash −2S · Qual +3",
        "outcome": {
          "effects": [
            { "stat": "cash_S", "amount": -2 },
            { "stat": "qual", "amount": 3 }
          ],
          "setFlags": ["stance_differentiate"],
          "narration": "Late to different is still different. It just cost more to get there."
        }
      },
      {
        "label": "Stay undecided",
        "known": "Share −2 · CSAT −3",
        "outcome": {
          "effects": [
            { "stat": "share_pt", "amount": -2 },
            { "stat": "csat", "amount": -3 }
          ],
          "narration": "The lane fills in without you. Customers can tell when nobody's driving."
        }
      }
    ]
  },
  {
